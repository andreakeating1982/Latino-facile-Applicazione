# Latino Facile — solo esempio pubblico, nessuna credenziale reale.
# cp .env.example .env
# Per Render aggiungere le variabili in Environment, non caricare .env.

# La piattaforma imposta PORT; in locale il default è 3000.
# PORT=3000

# Chiave server FACOLTATIVA per foto IA, colorazione/verifica e traduzione.
# Non richiede un database. Senza chiave l'app usa i ripieghi già previsti.
EASY_PEASY_API_KEY=

# Provider di traduzione alternativo già supportato; non richiesto per avviare.
DEEPL_API_KEY=

# Database PostgreSQL FACOLTATIVO, solo infrastruttura di autenticazione.
# Il flusso didattico principale e le funzioni IA NON richiedono DATABASE_URL.
# Non usare le credenziali della produzione per un clone o un test.
DATABASE_URL=

# Necessario insieme al DB se si desidera il login Better Auth.
# Generare nella destinazione: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Origini attendibili del login, separate da virgole; NON è il CORS dei font.
TRUSTED_ORIGINS=

# Provider login opzionali; lasciare vuoti se non usati.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Non servono S3, mappe, token del sandbox o VITE_* per il flusso base.
# Non inserire mai la chiave IA in una variabile VITE_* (sarebbe pubblica).
# Dettagli e dipendenze di rete: docs/CONFIGURAZIONE.md.
